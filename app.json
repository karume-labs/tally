{
  "expo": {
    "name": "Tally",
    "slug": "tally",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tally",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.karume-labs.tally",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFD340"
      },
      "package": "com.karume_labs.tally",
      "userInterfaceStyle": "automatic"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#101113",
          "dark": {
            "image": "./assets/images/splash.png",
            "backgroundColor": "#101113"
          }
        }
      ],
      "expo-status-bar",
      "./plugins/with-live-workout-service",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Streak",
              "label": "Tally streak",
              "description": "Your current streak and the last seven days.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/images/icon.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "TodayWorkout",
              "label": "Tally today",
              "description": "Today's plan, tomorrow's plan and your streak. Tap today to start the workout; tap the arrows to swipe.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/images/icon.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
